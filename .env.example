# 复制本文件为 .env 并填入你的百炼 DASHSCOPE_API_KEY（不要提交真实密钥）
DASHSCOPE_API_KEY=""

# R 模式（智能路由）可选：百炼决策模型业务空间 ID。
# 填写后 R 模式用 decision-model-preview（~50ms，choice/noul/score + 置信度）做路由判断；
# 留空则使用内置规则引擎（关键词/模式判断，零成本）。
# 获取方式：百炼控制台开通业务空间，取业务空间 ID（用于拼接 {WorkspaceId}.cn-beijing.maas.aliyuncs.com 网关域名）
DECISION_WORKSPACE_ID=

# IQS 联网搜索（阿里云统一搜索 cloud-iqs.aliyuncs.com，function calling 工具模式）。
# 配置后「联网搜索」开关开启时给 Generator 挂载 web_search 工具（模型按调用原则自主决定是否搜索）。
IQS_API_KEY=

# CompanionMem 长记忆（Yodada 生产同款：recall 返回 L0 原始/L1 蒸馏分层记忆 + context 分区，
# context 的 state/relation_state 有值时会覆盖 Director 输入的静态情绪/关系数据）。
# 配置 CM_API_URL/CM_API_KEY 后启用（优先于 Mem0）；recall 失败/无记忆时回落静态 data/memories.json。
CM_API_URL=
CM_API_KEY=

# CM_AGENT_ID 留空时使用写死的默认测试设备 c8:47:8c:de:ad:01（与生产记忆完全隔离，
# 且自动开启写入闭环：每轮对话 → 服务端蒸馏 L0→L1 → 后续召回）。
# 要接 Yodada 生产设备数据时才需要显式配置（此时写入必须显式 MEMORY_WRITE=on）。
CM_AGENT_ID=

# 写入开关：留空时走默认（默认测试设备=on，其他 agent=off）。
# on=每轮对话写入并触发服务端蒸馏；off=只读召回。
# ⚠️ 显式配置了生产 CM_AGENT_ID 时，写入会混入生产记忆库，务必确认后再开。
MEMORY_WRITE=

# Mem0 长记忆（上一代方案，复用 Yodada 的自建 Mem0 服务，扁平记忆无分层）。
# 三项都配置且 CM_* 未配置时生效；未配置时使用静态 data/memories.json。
MEM0_API_URL=
MEM0_API_KEY=
MEM0_AGENT_ID=

# 控制台模型 IO 调试日志开关（on/off，默认 on）；LOG_MAX_CHARS=2000 可截断超长文本
LOG_MODEL_IO=on
LOG_MAX_CHARS=0
